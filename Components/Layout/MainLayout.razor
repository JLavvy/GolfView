@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</HeadContent>

<div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50 h-20">
        <nav class="w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
            <div class="py-4 flex justify-between items-center ">
                <a href="/" class="font-heading text-2xl font-bold text-primary">
                    GolfView <span class="text-accent">Apartments</span>
                </a>

                <div class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-black font-body hover:text-accent transition-colors">Home</a>
                    <a href="/apartments" class="text-black font-body hover:text-accent transition-colors">Apartments</a>
                    <a href="/amenities" class="text-black font-body hover:text-accent transition-colors">Amenities</a>
                    <a href="/contact" class="text-black font-body hover:text-accent transition-colors">Contact</a>
                    <a href="/booking"
                        class="px-4 py-2 bg-accent font-body text-white rounded-lg hover:bg-accent/90 transition-colors font-medium">
                        Book Now
                    </a>
                </div>

                <button @onclick="ToggleMobileMenu" class="md:hidden text-foreground">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            @if (showMobileMenu)
            {
                <div class="md:hidden mt-4 pb-4 space-y-2">
                    <a href="/"
                        class="block px-4 py-2 font-body text-black hover:bg-secondary rounded-lg transition-colors">Home</a>
                    <a href="/apartments"
                        class="block px-4 py-2 font-body text-black hover:bg-secondary rounded-lg transition-colors">Apartments</a>
                    <a href="/amenities"
                        class="block px-4 py-2 font-body text-black hover:bg-secondary rounded-lg transition-colors">Amenities</a>
                    <a href="/contact"
                        class="block px-4 py-2 font-body text-black hover:bg-secondary rounded-lg transition-colors">Contact</a>
                    <a href="/booking"
                        class="block px-4 py-2 bg-accent font-body text-white rounded-lg hover:bg-accent/90 transition-colors text-center font-medium">
                        Book Now
                    </a>
                </div>
            }
        </nav>
    </header>


    <!-- Main Content -->
    <main class="flex-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-primary text-white py-16">
        <div class="w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="font-heading text-xl font-bold mb-4">GolfView Apartments</h3>
                    <p class="text-white mb-4 font-body">Experience luxury living with stunning golf course views.</p>
                    <a href="https://wa.me/0113198506" target="_blank"
                        class="inline-flex items-center gap-2 font-body bg-accent hover:bg-accent/90 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                        <!-- Font Awesome WhatsApp Icon -->
                        <i class="fab fa-whatsapp fa-lg"></i>
                        Chat on WhatsApp
                    </a>


                </div>
                <div>
                    <h4 class="font-bold font-heading text-lg mb-4">Quick Links</h4>
                    <ul class="space-y-6 text-sm font-body text-white">
                        <li><a href="/apartments" class="hover:text-accent transition-colors">Apartments</a></li>
                        <li><a href="/amenities" class="hover:text-accent transition-colors">Amenities</a></li>
                        <li><a href="/booking" class="hover:text-accent transition-colors">Booking</a></li>
                        <li><a href="/contact" class="hover:text-accent transition-colors">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold font-heading text-lg mb-4">Contact</h4>
                    <ul class="space-y-6 text-sm font-body text-white">
                        <li><a href="tel:+254113198506" target="_blank" class="hover:text-accent transition-colors">+254
                                700 000 000</a></li>
                        <li><a href="mailto:info@golfviewapartments.com" target="_blank"
                                class="hover:text-accent transition-colors">info@golfviewapartments.com</a></li>
                        <li>P.O. Box 79592 - 00200, Nairobi, Kenya.</li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-white font-bold font-heading text-lg mb-4">Office Hours</h3>
                    <ul class="space-y-6 text-sm font-body text-white">
                        <li class="flex justify-between">
                            <span>Monday - Friday</span>
                            <span>9:00 AM - 6:00 PM</span>
                        </li>
                        <li class="flex justify-between">
                            <span>Saturday</span>
                            <span>10:00 AM - 4:00 PM</span>
                        </li>
                        <li class="flex justify-between">
                            <span>Sunday</span>
                            <span>By Appointment</span>
                        </li>
                    </ul>
                </div>

            </div>
            <div class="border-t border-white/10 mt-8 pt-8 flex justify-between items-center text-sm font-body text-white/70">
                <p>&copy; @DateTime.Now.Year GolfView Apartments. All rights reserved.</p>
                <div class="flex space-x-4">
                    <a href="/admin/dashboard" class="hover:text-accent transition-colors">Admin Login</a>
                    <span class="border-l border-white h-4 mx-2"></span>
                    <a href="/" class="hover:text-accent transition-colors">Staff Login</a>

                </div>
                <div class="flex gap-4 mb-4 mt-4">
                    <a href="https://www.facebook.com/GolfViewServicedApartmentsNairobi/" target="_blank" class="text-white hover:text-accent font-body transition-colors">
                        <i class="fab fa-facebook text-xl"></i>
                    </a>
                    <a href="https://www.instagram.com/gvsa_ke/" target="_blank" class="text-white hover:text-accent font-body transition-colors">
                        <i class="fab fa-instagram text-xl"></i>
                    </a>

                </div>
            </div>

        </div>


    </footer>
</div>


@code {
    private bool showMobileMenu = false;

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }
}