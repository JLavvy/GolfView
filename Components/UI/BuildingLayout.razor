@using GolfViewApartments.Data
@using GolfViewApartments.Models

<div class="bg-card rounded-xl p-6 shadow-elegant">
    <div class="flex items-center gap-3 mb-6">
        <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3" />
            </svg>
        </div>
        <div>
            <h3 class="font-heading text-xl font-semibold text-black">Building Layout</h3>
            <p class="text-sm font-body text-muted-foreground">@ApartmentData.TotalFloors Floors • @ApartmentData.TotalUnits Total Apartments</p>
        </div>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap gap-4 mb-6 text-sm font-body">
        <div class="flex items-center gap-2">
            <div class="h-4 w-4 rounded bg-primary/20 border border-primary"></div>
            <span class="text-muted-foreground">Studio (24sqm)</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="h-4 w-4 rounded bg-accent/20 border border-accent"></div>
            <span class="text-muted-foreground">1-Bedroom (30sqm)</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="h-4 w-4 rounded bg-gold/20 border border-gold"></div>
            <span class="text-muted-foreground">2-Bedroom (40sqm)</span>
        </div>
    </div>

    <!-- Building Visualization -->
    <div class="space-y-2">
        @foreach (var floor in buildingLayout.OrderByDescending(f => f.Floor))
        {
            var floorPrefix = floor.Floor == 0 ? "G" : floor.Floor.ToString();
            var unitCounter = 1;
            
            <div class="flex items-center gap-3">
                <!-- Floor Label -->
                <div class="w-16 text-sm font-medium text-muted-foreground">
                    @(floor.Floor == 0 ? "Ground" : $"Floor {floor.Floor}")
                </div>

                <!-- Units Visualization -->
                <div class="flex-1 flex gap-1 flex-wrap font-body">
                    @{
                        var totalUnits = floor.Studios.Total + floor.OneBedroom.Total + floor.TwoBedroom.Total;
                        var studioIndex = 0;
                        var oneBedroomIndex = 0;
                        var twoBedroomIndex = 0;
                        
                        for (int i = 0; i < totalUnits; i++)
                        {
                            var unitType = i % 3; // 0 = Studio, 1 = 1-Bedroom, 2 = 2-Bedroom
                            var roomNumber = $"{floorPrefix}{unitCounter:D2}";
                            unitCounter++;
                            
                            if (unitType == 0 && studioIndex < floor.Studios.Total)
                            {
                                // Studio
                                var isAvailable = studioIndex < floor.Studios.Available;
                                var statusClass = isAvailable 
                                    ? "bg-primary/20 border border-primary text-primary" 
                                    : "bg-muted border border-border text-muted-foreground";
                                var status = isAvailable ? "Available" : "Occupied";
                                studioIndex++;
                                
                                <div class="h-10 w-12 rounded flex flex-col items-center justify-center text-xs font-medium transition-colors @statusClass"
                                     title="Studio - Room @roomNumber (@status)">
                                    <span class="font-semibold text-[11px]">@roomNumber</span>
                                    <span class="text-[9px] opacity-75">S</span>
                                </div>
                            }
                            else if (unitType == 1 && oneBedroomIndex < floor.OneBedroom.Total)
                            {
                                // 1-Bedroom
                                var isAvailable = oneBedroomIndex < floor.OneBedroom.Available;
                                var statusClass = isAvailable 
                                    ? "bg-accent/20 border border-accent text-accent" 
                                    : "bg-muted border border-border text-muted-foreground";
                                var status = isAvailable ? "Available" : "Occupied";
                                oneBedroomIndex++;
                                
                                <div class="h-10 w-12 rounded flex flex-col items-center justify-center text-xs font-medium transition-colors @statusClass"
                                     title="1-Bedroom - Room @roomNumber (@status)">
                                    <span class="font-semibold text-[11px]">@roomNumber</span>
                                    <span class="text-[9px] opacity-75">1B</span>
                                </div>
                            }
                            else if (unitType == 2 && twoBedroomIndex < floor.TwoBedroom.Total)
                            {
                                // 2-Bedroom
                                var isAvailable = twoBedroomIndex < floor.TwoBedroom.Available;
                                var statusClass = isAvailable 
                                    ? "bg-gold/20 border border-gold text-gold" 
                                    : "bg-muted border border-border text-muted-foreground";
                                var status = isAvailable ? "Available" : "Occupied";
                                twoBedroomIndex++;
                                
                                <div class="h-10 w-12 rounded flex flex-col items-center justify-center text-xs font-medium transition-colors @statusClass"
                                     title="2-Bedroom - Room @roomNumber (@status)">
                                    <span class="font-semibold text-[11px]">@roomNumber</span>
                                    <span class="text-[9px] opacity-75">2B</span>
                                </div>
                            }
                            else
                            {
                                // If we run out of one type, skip to the next in sequence
                                i--;
                            }
                        }
                    }
                </div>

                <!-- Availability Summary -->
                <div class="text-xs text-muted-foreground w-20 text-right">
                    @(floor.Studios.Available + floor.OneBedroom.Available + floor.TwoBedroom.Available)/@(floor.Studios.Total + floor.OneBedroom.Total + floor.TwoBedroom.Total) free
                </div>
            </div>
        }
    </div>

    <!-- Floor Summary -->
    <div class="mt-6 pt-6 border-t border-border">
        <div class="grid grid-cols-3 gap-4 text-center">
            @foreach (var apt in ApartmentData.Apartments)
            {
                <div class="space-y-1">
                    <p class="text-2xl font-heading font-bold text-black">@apt.Units</p>
                    <p class="text-xs font-body text-muted-foreground">@apt.Name@(apt.Units > 1 ? "s" : "")</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FloorInfo> buildingLayout = new();

    protected override void OnInitialized()
    {
        buildingLayout = ApartmentData.GetBuildingLayout();
    }
}