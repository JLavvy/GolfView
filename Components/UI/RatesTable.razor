@using GolfViewApartments.Data
@using GolfViewApartments.Models

<div class="bg-card rounded-xl shadow-elegant overflow-hidden">
    <div class="bg-primary p-6">
        <h3 class="font-heading text-xl font-semibold text-primary-foreground">
            Room Rates (KES)
        </h3>
        <p class="text-sm font-body text-black mt-1">
            All rooms feature 5x6 beds • Prices in Kenyan Shillings
        </p>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="text-left p-4 font-heading font-semibold text-black">Room Type</th>
                    <th class="text-center p-4 font-heading font-semibold text-black">Daily B/O</th>
                    <th class="text-center p-4 font-heading font-semibold text-black">Daily B+B</th>
                    <th class="text-center p-4 font-heading font-semibold text-black">Monthly B/O</th>
                    <th class="text-center p-4 font-heading font-semibold text-black">Monthly B+B</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border font-body">
                @foreach (var apt in ApartmentData.Apartments)
                {
                    <tr class="hover:bg-primary/10 transition-colors">
                        <td class="p-4">
                            <div class="flex items-start gap-3">
                                <img src="@apt.Image"
                                     alt="@apt.Name"
                                     class="w-16 h-12 object-cover rounded" />
                                <div>
                                    <p class="font-semibold text-black">@apt.Name</p>
                                    <div class="flex items-center gap-3 mt-1 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-expand"></i>
                                            @apt.Size
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-users"></i>
                                            Max @apt.MaxGuests
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-bed"></i>
                                            @apt.BedSize
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-center">
                            <span class="font-semibold text-muted-foreground">@apt.Pricing.DailyBedOnly.ToString("N0")</span>
                        </td>
                        <td class="p-4 text-center">
                            <span class="font-semibold text-muted-foreground">@apt.Pricing.DailyBB.ToString("N0")</span>
                        </td>
                        <td class="p-4 text-center">
                            <span class="font-semibold text-muted-foreground">@apt.Pricing.MonthlyBedOnly.ToString("N0")</span>
                        </td>
                        <td class="p-4 text-center">
                            <span class="font-semibold text-muted-foreground">@apt.Pricing.MonthlyBB.ToString("N0")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="p-4 text-sm text-muted-foreground font-body">
        <p><strong>B/O</strong> = Bed Only | <strong>B+B</strong> = Bed & Breakfast</p>
    </div>
</div>