@page "/search-results"
@using GolfViewApartments.Data
@using GolfViewApartments.Models
@inject NavigationManager Navigation

<div class="min-h-screen bg-gray-50">

    <!-- HEADER -->
    <div class="bg-primary py-16">
        <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">

            <a href="/" class="inline-flex items-center gap-2 text-white/80 hover:text-white mb-4 font-body">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Home
            </a>

            <h1 class="text-3xl font-bold font-heading mb-4 text-white">
                Available Apartments
            </h1>

            <!-- SEARCH SUMMARY -->
            <div class="flex flex-wrap gap-4 text-sm font-body text-gray-900">
                @if (CheckIn.HasValue && CheckOut.HasValue)
                {
                    <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-lg">
                        <span>@CheckIn.Value.ToString("MMM dd, yyyy") - @CheckOut.Value.ToString("MMM dd, yyyy")</span>
                        <span class="ml-2 bg-gray-200 px-2 py-1 rounded text-xs font-medium">
                            @Nights @(Nights == 1 ? "night" : "nights")
                        </span>
                    </div>
                }

                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-lg">
                    <span>
                        @Adults @(Adults == 1 ? "Adult" : "Adults")
                        @(Children > 0 ? $", {Children} {(Children == 1 ? "Child" : "Children")}" : "")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- RESULTS -->
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px] py-10">

        <p class="text-muted-foreground mb-6 font-heading">
            @AvailableApartments.Count @(AvailableApartments.Count == 1 ? "apartment" : "apartments") available
        </p>

        @if (AvailableApartments.Count > 0)
        {
            <!-- GRID -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                @foreach (var apartment in AvailableApartments)
                {
                    var pricePerNight = apartment.Pricing.DailyBedOnly;
                    var totalPrice = pricePerNight * Nights;

                    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow flex flex-col h-full">

                        <!-- IMAGE -->
                        <div class="h-56 relative">
                            <img src="@apartment.Image"
                            alt="@apartment.Name"
                            class="w-full h-full object-cover rounded-t-lg" />
                        </div>

                        <!-- CONTENT -->
                        <div class="p-6 flex flex-col flex-1">

                            <h3 class="text-xl font-heading font-semibold mb-2">
                                @apartment.Name
                            </h3>

                            <p class="text-muted-foreground mb-4 line-clamp-3">
                                @apartment.Description
                            </p>

                            <!-- QUICK INFO -->
                            <div class="flex flex-wrap gap-4 text-sm mb-4 font-body">
                                <span>@apartment.Bedrooms Bedrooms</span>
                                <span>Max @apartment.MaxGuests Guests</span>
                                <span>@apartment.Size</span>
                            </div>

                            <!-- AMENITIES -->
                            <div class="flex flex-wrap gap-2 text-sm text-muted-foreground mb-4 font-body">
                                @foreach (var amenity in apartment.Amenities.Take(5))
                                {
                                    <span>✓ @amenity</span>
                                }
                            </div>

                            <!-- PRICE + CTA (BOTTOM ALIGNED) -->
                            <div class="mt-auto font-body">
                                <p class="text-sm text-muted-foreground ">Price per night</p>
                                <p class="text-2xl font-bold text-black ">
                                    KES @pricePerNight.ToString("N0")
                                </p>

                                @if (Nights > 0)
                                {
                                    <p class="text-sm text-muted-foreground mt-1">
                                        Total: <span class="font-semibold text-gray-900">
                                            KES @totalPrice.ToString("N0")
                                        </span> for @Nights nights
                                    </p>
                                }

                                <button @onclick="() => BookNow(apartment.Id)"
                                        class="mt-4 w-full bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-2 rounded-lg transition-colors">
                                    Book Now
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- EMPTY STATE -->
            <div class="bg-white rounded-lg shadow p-12 text-center font-heading">
                <p class="text-xl text-muted-foreground mb-4">
                    No apartments available for your criteria
                </p>
                <p class="text-sm text-muted-foreground mb-6">
                    Try adjusting your dates or number of guests
                </p>
                <a href="/" class="inline-block border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-6 py-2 rounded-lg">
                    Modify Search
                </a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "checkIn")]
    public string? CheckInParam { get; set; }

    [SupplyParameterFromQuery(Name = "checkOut")]
    public string? CheckOutParam { get; set; }

    [SupplyParameterFromQuery(Name = "adults")]
    public int Adults { get; set; } = 2;

    [SupplyParameterFromQuery(Name = "children")]
    public int Children { get; set; } = 0;

    private DateTime? CheckIn { get; set; }
    private DateTime? CheckOut { get; set; }

    private int TotalGuests => Adults + Children;

    private int Nights =>
        CheckIn.HasValue && CheckOut.HasValue
            ? (int)Math.Ceiling((CheckOut.Value - CheckIn.Value).TotalDays)
            : 0;

    private List<Apartment> AvailableApartments { get; set; } = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(CheckInParam) &&
            DateTime.TryParse(CheckInParam, out var checkIn))
        {
            CheckIn = checkIn;
        }

        if (!string.IsNullOrEmpty(CheckOutParam) &&
            DateTime.TryParse(CheckOutParam, out var checkOut))
        {
            CheckOut = checkOut;
        }

        AvailableApartments = ApartmentData.Apartments
            .Where(a => a.MaxGuests >= TotalGuests)
            .ToList();
    }

    private void BookNow(string apartmentId)
    {
        var queryParams =
            $"?apartment={apartmentId}" +
            $"&checkIn={CheckInParam}" +
            $"&checkOut={CheckOutParam}" +
            $"&adults={Adults}" +
            $"&children={Children}";

        Navigation.NavigateTo($"/booking{queryParams}");
    }
}
