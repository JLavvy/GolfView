@page "/admin/dashboard"
@inject NavigationManager Navigation
@layout Pages.Admin.Dashboard.Layout

<div>
    <!-- Welcome Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h2 class="text-2xl sm:text-3xl font-heading font-semibold tracking-tight">
                Good @GetGreeting()! 👋
            </h2>
            <p class="text-muted-foreground font-body mt-1">
                Here's what's happening at GolfView today.
            </p>
        </div>
        <div class="flex gap-2">
            @foreach (var action in quickActions)
            {
                <button @onclick="() => HandleQuickAction(action.Path, action.Label)" 
                        class="hidden sm:flex gap-2 border-border/50 px-3 py-2 rounded-md border text-sm hover:bg-accent hover:text-accent-foreground transition-colors">
                    <i class="@action.Icon"></i>
                    @action.Label
                </button>
            }
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-4 lg:gap-6">
        @foreach (var stat in stats)
        {
            <div @onclick="() => HandleStatClick(stat.Path, stat.Title)" 
                class="group bg-white hover:shadow-soft transition-all duration-300 cursor-pointer rounded-lg ">
                <div class="p-6">
                    <div class="flex items-start justify-between">
                        <div class="p-2.5 rounded-xl @stat.BgColor">
                            <i class="@stat.Icon @stat.TextColor text-lg"></i>
                        </div>
                        <button @onclick:stopPropagation="true" @onclick="() => HandleStatClick(stat.Path, stat.Title)"
                                class="h-8 w-8 opacity-0 group-hover:opacity-100 transition-opacity hover:bg-accent hover:text-accent-foreground rounded-md inline-flex items-center justify-center">
                            <i class="fas fa-ellipsis-h text-sm"></i>
                        </button>
                    </div>
                    <div class="mt-4">
                        <p class="text-sm text-muted-foreground font-body">@stat.Title</p>
                        <p class="text-2xl font-heading mt-1">@stat.Value</p>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3">
                        @if (stat.Trend == "up")
                        {
                            <i class="fas fa-arrow-trend-up text-xs text-primary"></i>
                        }
                        else if (stat.Trend == "down")
                        {
                            <i class="fas fa-arrow-trend-down text-xs text-destructive"></i>
                        }
                        <span class="text-xs font-medium @(stat.Trend == "up" ? "text-primary" : stat.Trend == "down" ? "text-destructive" : "text-muted-foreground")">
                            @stat.Change
                        </span>
                        @if (stat.Trend != "neutral")
                        {
                            <span class="text-xs text-muted-foreground font-body">vs last month</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Recent Bookings -->
    <div class="rounded-lg bg-white shadow-soft">
        <div class="flex flex-row items-center justify-between pb-4 p-6">
            <div>
                <h3 class="font-heading text-lg font-semibold leading-none tracking-tight">Recent Bookings</h3>
                <p class="text-sm text-muted-foreground font-body mt-1">Latest reservation activity</p>
            </div>
            <button @onclick='() => HandleNavigation("/admin/dashboard/bookings")' 
                    class="text-primary gap-1 hover:bg-accent hover:text-accent-foreground px-3 py-2 rounded-md text-sm inline-flex items-center">
                View All
                <i class="fas fa-arrow-up-right text-xs"></i>
            </button>
        </div>
        <div class="p-6 pt-0">
            <div class="space-y-4 font-body">
                @foreach (var booking in recentBookings)
                {
                    <div @onclick="() => HandleBookingClick(booking)" 
                        class="flex items-center gap-4 p-3 rounded-xl hover:bg-foreground transition-colors group cursor-pointer">
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                            <span class="text-sm font-medium text-primary">@booking.Avatar</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <p class="font-medium ">@booking.Guest</p>
                                <span class="@GetBadgeClass(booking.Status) inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold transition-colors">
                                    @booking.Status
                                </span>
                            </div>
                            <p class="text-sm font-medium text-muted-foreground">@booking.Room</p>
                        </div>
                        <div class="text-right sm:block">
                            <p class="text-sm text-black font-medium">@booking.CheckIn</p>
                            <p class="text-xs text-muted-foreground">to @booking.CheckOut</p>
                        </div>
                        <button @onclick:stopPropagation="true" @onclick="() => HandleBookingClick(booking)"
                                class="h-8 w-8 opacity-0 group-hover:opacity-100 transition-opacity hover:bg-accent hover:text-accent-foreground rounded-md inline-flex items-center justify-center">
                            <i class="fas fa-arrow-up-right text-xs"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4 bg-white">
        <div @onclick='() => HandleNavigation("/admin/dashboard/availability")' 
             class="cursor-pointer hover:shadow-md transition-shadow rounded-lg shadow-soft">
            <div class="p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground font-body">Occupancy Rate</p>
                        <p class="text-3xl font-heading mt-1">54%</p>
                    </div>
                    <div class="w-16 h-16 rounded-full border-4 border-primary/20 flex items-center justify-center">
                        <span class="text-lg font-heading text-primary">54%</span>
                    </div>
                </div>
            </div>
        </div>
        <div @onclick='() => HandleNavigation("/admin/dashboard/bookings")' 
            class="cursor-pointer hover:shadow-md transition-shadow rounded-lg shadow-sm">
            <div class="p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground font-body">Avg. Stay</p>
                        <p class="text-3xl font-heading mt-1">4.2<span class="text-lg text-muted-foreground ml-1">nights</span></p>
                    </div>
                    <i class="fas fa-calendar-days text-5xl text-accent/30"></i>
                </div>
            </div>
        </div>
        <div @onclick="() => HandlePendingReviews()" 
            class="cursor-pointer hover:shadow-md transition-shadow rounded-lg shadow-sm">
            <div class="p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground font-body">Pending Reviews</p>
                        <p class="text-3xl font-heading mt-1">3</p>
                    </div>
                    <span class="bg-accent text-accent-foreground inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold">
                        Action Needed
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<StatItem> stats = new()
    {
        new StatItem
        {
            Title = "Total Bookings",
            Value = "24",
            Change = "+12%",
            Trend = "up",
            Icon = "fas fa-calendar-check",
            Color = "primary",
            BgColor = "bg-primary/10",
            TextColor = "text-primary",
            Path = "/admin/dashboard/bookings"
        },
        new StatItem
        {
            Title = "Active Guests",
            Value = "18",
            Change = "+5%",
            Trend = "up",
            Icon = "fas fa-user-group",
            Color = "accent",
            BgColor = "bg-accent/10",
            TextColor = "text-accent",
            Path = "/admin/dashboard/bookings"
        },
        new StatItem
        {
            Title = "This Month",
            Value = "Ksh 450K",
            Change = "+18%",
            Trend = "up",
            Icon = "fas fa-coins",
            Color = "primary",
            BgColor = "bg-primary/10",
            TextColor = "text-primary",
            Path = "/admin/dashboard/pricing"
        },
        new StatItem
        {
            Title = "Available Rooms",
            Value = "21",
            Change = "of 39",
            Trend = "neutral",
            Icon = "fas fa-door-open",
            Color = "muted",
            BgColor = "bg-muted",
            TextColor = "text-muted-foreground",
            Path = "/admin/dashboard/availability"
        }
    };

    private List<BookingItem> recentBookings = new()
    {
        new BookingItem { Id = 1, Guest = "John Kamau", Room = "Studio #5", CheckIn = "Dec 18", CheckOut = "Dec 22", Status = "confirmed", Avatar = "JK" },
        new BookingItem { Id = 2, Guest = "Mary Wanjiku", Room = "1 Bedroom #12", CheckIn = "Dec 20", CheckOut = "Dec 25", Status = "pending", Avatar = "MW" },
        new BookingItem { Id = 3, Guest = "David Ochieng", Room = "2 Bedroom #8", CheckIn = "Dec 21", CheckOut = "Jan 5", Status = "confirmed", Avatar = "DO" },
        new BookingItem { Id = 4, Guest = "Sarah Muthoni", Room = "Studio #3", CheckIn = "Dec 23", CheckOut = "Dec 28", Status = "confirmed", Avatar = "SM" }
    };

    private List<QuickAction> quickActions = new()
    {
        new QuickAction { Label = "Add Booking", Icon = "fas fa-calendar-plus", Path = "/admin/dashboard/bookings" },
        new QuickAction { Label = "Upload Photo", Icon = "fas fa-image", Path = "/admin/dashboard/photos" },
        new QuickAction { Label = "Update Rates", Icon = "fas fa-dollar-sign", Path = "/admin/dashboard/pricing" }
    };

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Morning";
        if (hour < 18) return "Afternoon";
        return "Evening";
    }

    private string GetBadgeClass(string status)
    {
        return status == "confirmed"
            ? "bg-primary/10 text-primary border-primary/20"
            : "bg-accent/10 text-accent border-accent/20";
    }

    private void HandleStatClick(string path, string title)
    {
        Navigation.NavigateTo(path);
    }

    private void HandleBookingClick(BookingItem booking)
    {
        Navigation.NavigateTo($"/admin/dashboard/bookings/{booking.Id}");
    }

    private void HandleNavigation(string path)
    {
        Navigation.NavigateTo(path);
    }

    private void HandleQuickAction(string path, string label)
    {
        Navigation.NavigateTo(path);
    }

    private void HandlePendingReviews()
    {
        Navigation.NavigateTo("/admin/dashboard/reviews");
    }

    // Models
    private class StatItem
    {
        public string Title { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
        public string Change { get; set; } = string.Empty;
        public string Trend { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
        public string BgColor { get; set; } = string.Empty;
        public string TextColor { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
    }

    private class BookingItem
    {
        public int Id { get; set; }
        public string Guest { get; set; } = string.Empty;
        public string Room { get; set; } = string.Empty;
        public string CheckIn { get; set; } = string.Empty;
        public string CheckOut { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Avatar { get; set; } = string.Empty;
    }

    private class QuickAction
    {
        public string Label { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
    }
}