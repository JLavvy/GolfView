@* @using GolfViewApartments.Models
@inject IJSRuntime JS

<div class="space-y-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-heading text-primary">Contact Information</h1>
            <p class="text-muted-foreground font-body mt-1">
                Update your property's contact details.
            </p>
        </div>
        <button
            class="btn-primary gap-2 inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors h-10 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90"
            @onclick="HandleSave">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            Save Changes
        </button>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
        <!-- Main Contact Info -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-heading text-2xl font-semibold leading-none tracking-tight">Contact Details</h3>
            </div>
            <div class="p-6 pt-0 space-y-6">
                <div class="space-y-2">
                    <label class="font-body flex items-center gap-2 text-sm font-medium leading-none">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Address
                    </label>
                    <textarea @bind="contactInfo.Address"
                        class="bg-secondary flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background"
                        rows="2">
                    </textarea>
                </div>

                <div class="space-y-2">
                    <label class="font-body flex items-center gap-2 text-sm font-medium leading-none">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        Phone Number
                    </label>
                    <input @bind="contactInfo.Phone"
                        class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                </div>

                <div class="space-y-2">
                    <label class="font-body flex items-center gap-2 text-sm font-medium leading-none">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Email Address
                    </label>
                    <input type="email" @bind="contactInfo.Email"
                        class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                </div>

                <div class="space-y-2">
                    <label class="font-body flex items-center gap-2 text-sm font-medium leading-none">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                        WhatsApp Number
                    </label>
                    <input @bind="contactInfo.Whatsapp"
                        class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                </div>

                <div class="space-y-2">
                    <label class="font-body flex items-center gap-2 text-sm font-medium leading-none">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                        Website
                    </label>
                    <input type="url" @bind="contactInfo.Website"
                        class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                </div>
            </div>
        </div>

        <!-- Description & Social -->
        <div class="space-y-8">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-heading text-2xl font-semibold leading-none tracking-tight">Property Description
                    </h3>
                </div>
                <div class="p-6 pt-0">
                    <div class="space-y-2">
                        <label class="font-body text-sm font-medium leading-none">About the Property</label>
                        <textarea @bind="contactInfo.Description"
                            class="bg-secondary min-h-[150px] flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm"
                            placeholder="Describe your property..."></textarea>
                        <p class="text-xs text-muted-foreground font-body">
                            This appears in the footer and about sections of the website.
                        </p>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-heading text-2xl font-semibold leading-none tracking-tight">Social Media Links</h3>
                </div>
                <div class="p-6 pt-0 space-y-4">
                    <div class="space-y-2">
                        <label class="font-body text-sm font-medium leading-none">Facebook</label>
                        <input type="url" @bind="socialLinks.Facebook" placeholder="https://facebook.com/..."
                            class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                    </div>
                    <div class="space-y-2">
                        <label class="font-body text-sm font-medium leading-none">Instagram</label>
                        <input type="url" @bind="socialLinks.Instagram" placeholder="https://instagram.com/..."
                            class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                    </div>
                    <div class="space-y-2">
                        <label class="font-body text-sm font-medium leading-none">Twitter / X</label>
                        <input type="url" @bind="socialLinks.Twitter" placeholder="https://twitter.com/..."
                            class="bg-secondary flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ContactInfo contactInfo = new()
    {
        Address = "Muchai Drive, off Ngong Road, Nairobi, Kenya",
        Phone = "+254 700 000 000",
        Email = "info@golfviewapartments.co.ke",
        Whatsapp = "+254 700 000 000",
        Website = "https://golfviewapartments.co.ke",
        Description = "Nestled in the quiet and tranquil Muchai drive off Ngong Road, Golfview provides secure first-class accommodation second to none! We offer daily housekeeping services inclusive of linen replacement, dish washing services and free shoe cleaning."
    };

    private SocialLinks socialLinks = new()
    {
        Facebook = "",
        Instagram = "",
        Twitter = ""
    };

    private async Task HandleSave()
    {
        await JS.InvokeVoidAsync("alert", "Contact information updated!");
    }
} *@