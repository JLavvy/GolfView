@page "/admin/dashboard/contact"
@layout Pages.Admin.Dashboard.Layout

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-semibold font-heading">Contact Info</h2>
            <p class="text-muted-foreground font-body text-sm mt-1">
                Update your property's contact details and social links
            </p>
        </div>
        <div class="flex items-center gap-3 ml-auto">
            <div class="flex items-center gap-1 p-1  rounded-lg">
                <button
                    class="bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg shadow-lg shadow-primary/25 flex items-center gap-2"
                    @onclick="SaveChanges" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk"></i>
                    }
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>

    @if (saveMessage != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4">
            <p class="text-sm font-medium">@saveMessage</p>
        </div>
    }

    <!-- Preview Card -->
    <div class="border border-gray-200 rounded-xl bg-card overflow-hidden">
       <div class="p-6 flex flex-row gap-6">
            <div class="p-4 rounded-2xl bg-primary/20 self-start">
                <i class="fa-solid fa-building text-4xl text-primary"></i>
            </div>
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                    <h3 class="text-xl font-semibold font-heading">GolfView Apartments</h3>
                    <span class="px-2 py-0.5 text-xs text-white rounded bg-accent font-medium">Live
                        Preview</span>
                </div>
                <p class="text-muted-foreground font-body text-sm mb-4">@contactInfo.Address</p>
                <div class="flex flex-wrap gap-4 text-sm">
                    <span class="flex items-center gap-1.5 font-body text-muted-foreground">
                        <i class="fa-solid fa-phone"></i>
                        @contactInfo.Phone
                    </span>
                    <span class="flex items-center gap-1.5 font-body text-muted-foreground">
                        <i class="fa-regular fa-envelope"></i>
                        @contactInfo.Email
                    </span>
                    <a href="@contactInfo.Website" target="_blank"
                        class="flex items-center gap-1.5 text-primary font-body hover:underline">
                        <i class="fa-solid fa-globe"></i>
                        Website 
                        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
        <!-- Main Contact Info -->
        <div class="border border-gray-200 rounded-xl bg-white">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold font-body flex items-center gap-2">
                    <i class="fa-solid fa-phone text-primary"></i>
                    Contact Details
                </h3>
            </div>
            <div class="p-6 space-y-6 font-body">
                <div class="space-y-4">
                    <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                        <i class="fa-solid fa-location-dot text-primary"></i>
                        Physical Address
                    </label>
                    <textarea @bind="contactInfo.Address" @bind:event="oninput"
                        class="w-full px-3 py-2 bg-card border border-gray-200 rounded-lg min-h-[80px] focus:outline-none focus:ring-none focus:ring-none transition-colors"
                        placeholder="Enter address..."></textarea>
                </div>

                <div class="space-y-4">
                    <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                        <i class="fa-solid fa-phone text-primary"></i>
                        Phone Number
                    </label>
                    <input type="tel" @bind="contactInfo.Phone" @bind:event="oninput"
                        class="w-full h-11 px-3 py-2 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                </div>

                <div class="space-y-4">
                    <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                        <i class="fa-regular fa-envelope text-primary"></i>
                        Email Address
                    </label>
                    <input type="email" @bind="contactInfo.Email" @bind:event="oninput"
                        class="w-full h-11 px-3 py-2 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                </div>

                <div class="space-y-4">
                    <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                        <i class="fa-brands fa-whatsapp text-primary"></i>
                        WhatsApp Number
                    </label>
                    <input type="tel" @bind="contactInfo.WhatsApp" @bind:event="oninput"
                        class="w-full h-11 px-3 py-2 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                </div>

                <div class="space-y-4">
                    <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                        <i class="fa-solid fa-globe text-primary"></i>
                        Website URL
                    </label>
                    <input type="url" @bind="contactInfo.Website" @bind:event="oninput"
                        class="w-full h-11 px-3 py-2 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <!-- Description -->
            <div class="border border-gray-200 rounded-xl bg-white">
                <div class="p-6 border-b border-gray-200">
                    <h3 class="text-lg font-semibold font-body flex items-center gap-2">
                        <i class="fa-solid fa-building text-primary"></i>
                        Property Description
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-2">
                        <textarea @bind="contactInfo.Description" @bind:event="oninput"
                            class="w-full px-3 py-2 bg-card border border-gray-200 rounded-lg min-h-[150px] focus:outline-none focus:ring-none focus:ring-none transition-colors"
                            placeholder="Describe your property..."></textarea>
                        <div class="flex items-center justify-between">
                            <p class="text-xs text-muted-foreground font-body">
                                Appears in footer and about sections
                            </p>
                            <span class="px-2 py-0.5 text-xs font-body border border-gray-200 rounded">
                                @contactInfo.Description.Length characters
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Social Media -->
            <div class="border border-gray-200 rounded-xl bg-white">
                <div class="p-6 border-b border-gray-200">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold font-body">Social Media</h3>
                        
                    </div>
                </div>
                <div class="p-6 space-y-4 font-body">
                    <div class="space-y-2">
                        <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                            <i class="fa-brands fa-facebook text-primary"></i>
                            Facebook
                        </label>
                        <input type="url" @bind="socialLinks.Facebook" @bind:event="oninput"
                            placeholder="https://facebook.com/..."
                            class="w-full h-10 px-3 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                            <i class="fa-brands fa-instagram text-primary"></i>
                            Instagram
                        </label>
                        <input type="url" @bind="socialLinks.Instagram" @bind:event="oninput"
                            placeholder="https://instagram.com/..."
                            class="w-full h-10 px-3 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-2">
                            <i class="fa-brands fa-x-twitter text-primary"></i>
                            Twitter / X
                        </label>
                        <input type="url" @bind="socialLinks.Twitter" @bind:event="oninput"
                            placeholder="https://twitter.com/..."
                            class="w-full h-10 px-3 bg-card border border-gray-200 rounded-lg focus:outline-none focus:ring-none focus:ring-none transition-colors" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isSaving = false;
    private string? saveMessage;

    private Contact contactInfo = new()
    {
        Address = "Muchai Drive, off Ngong Road, Nairobi, Kenya",
        Phone = "+254 700 000 000",
        Email = "info@golfviewapartments.co.ke",
        WhatsApp = "+254 700 000 000",
        Website = "https://golfviewapartments.co.ke",
        Description = "Nestled in the quiet and tranquil Muchai drive off Ngong Road, Golfview provides secure first-class accommodation second to none! We offer daily housekeeping services inclusive of linen replacement, dish washing services and free shoe cleaning."
    };

    private SocialLinks socialLinks = new()
    {
        Facebook = "",
        Instagram = "",
        Twitter = ""
    };

    private async Task SaveChanges()
    {
        isSaving = true;
        saveMessage = null;
        StateHasChanged();

        await Task.Delay(500); // Simulate API call

        isSaving = false;
        saveMessage = "Contact information updated successfully!";
        StateHasChanged();

        await Task.Delay(3000);
        saveMessage = null;
        StateHasChanged();
    }

    private class Contact
    {
        public string Address { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string WhatsApp { get; set; } = "";
        public string Website { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class SocialLinks
    {
        public string Facebook { get; set; } = "";
        public string Instagram { get; set; } = "";
        public string Twitter { get; set; } = "";
    }
}