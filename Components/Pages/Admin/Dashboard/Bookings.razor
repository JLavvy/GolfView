@page "/admin/dashboard/bookings"
@layout Pages.Admin.Dashboard.Layout

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-semibold font-heading">Bookings</h2>
            <p class="text-muted-foreground text-sm font-body mt-1">
                Manage all reservation requests and inquiries
            </p>
        </div>
        <div class="flex items-center gap-3 ml-auto">
            <div class="flex items-center gap-1 p-1 font-body rounded-lg">
                <button
                    class="bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg shadow-lg shadow-primary/25 flex items-center gap-2"
                    @onclick="ShowNewBookingMessage">
                    <i class="fa-regular fa-calendar"></i>
                    New Booking
                </button>
            </div>
        </div>
    </div>

    @if (statusMessage != null)
    {
        <div
            class="@(statusMessageSuccess ? "bg-primary/50 border-primary/20 text-white" : "bg-primary/50 border-primary/20 text-white") border rounded-lg p-4">
            <p class="text-sm font-medium font-body">@statusMessage</p>
        </div>
    }

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-5 lg:grid-cols-5 bg-white gap-3">
        @foreach (var stat in statusStats)
        {
            <button class="@GetStatButtonClasses(stat.Label) p-4 rounded-xl border text-left transition-all"
                @onclick="() => FilterByStatus(stat.Label)">
                <p class="text-2xl font-heading">@stat.Count</p>
                <p class="text-sm text-muted-foreground font-body">@stat.Label</p>
            </button>
        }
    </div>

    <!-- Filters -->
    <div class="border border-gray-200 rounded-xl bg-white p-4">
        <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
    
    <input type="text" placeholder="Search by guest, email, or room..." @bind="searchTerm" @bind:event="oninput" 
        class="w-full h-10 pl-10 pr-3 bg-card border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-0" />
</div>

            <div class="relative w-full sm:w-[180px] font-body">
                <select class="w-full h-10 pl-3 pr-10 bg-card border border-gray-200 rounded-lg  appearance-none focus:outline-none focus:ring-0" @bind="statusFilter">
                    <option value="All">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>

                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
            </div>

        </div>
    </div>

    <!-- Bookings List -->
    <div class="space-y-3">
    @foreach (var booking in FilteredBookings)
    {
        <div
            class="border border-gray-200 rounded-xl bg-white hover:border-gray-300 hover:shadow-md transition-all duration-300 group">
            <div class="p-4 sm:p-6">
                <!-- MAIN ROW -->
                <div class="flex items-center justify-between gap-6 flex-nowrap">

                    <!-- Guest Info (LEFT) -->
                    <div class="flex items-center gap-4 flex-1 min-w-0">
                        <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center shrink-0">
                            <span class="text-sm font-semibold font-body text-primary">
                                @GetInitials(booking.Guest)
                            </span>
                        </div>

                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <p class="font-medium font-body truncate">
                                    @booking.Guest
                                </p>
                                <span class="@GetStatusBadgeClasses(booking.Status) px-2 py-0.5 text-xs border rounded">
                                    @booking.Status
                                </span>
                            </div>

                            <div class="flex items-center gap-4 mt-1 text-sm font-body text-muted-foreground">
                                <span class="flex items-center gap-1 min-w-0">
                                    <i class="fa-regular fa-envelope text-muted-foreground"></i>
                                    <span class="truncate max-w-[150px]">
                                        @booking.Email
                                    </span>
                                </span>

                                <span class="flex items-center gap-1">
                                    <i class="fa-solid fa-phone text-muted-foreground"></i>
                                    @booking.Phone
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Details (CENTER) -->
                    <div class="flex items-center gap-8 shrink-0">
                        <div class="text-sm">
                            <p class="font-heading text-muted-foreground">Room</p>
                            <p class="font-medium font-body">@booking.Room</p>
                        </div>

                        <div class="text-sm">
                            <p class="font-heading text-muted-foreground">Check-in</p>
                            <p class="font-medium font-body">@booking.CheckIn</p>
                        </div>

                        <div class="text-sm">
                            <p class="font-heading text-muted-foreground">Check-out</p>
                            <p class="font-medium font-body">@booking.CheckOut</p>
                        </div>

                        <div class="text-sm">
                            <p class="font-heading text-muted-foreground">Guests</p>
                            <p class="font-medium font-body flex items-center gap-1">
                                <i class="fa-solid fa-users text-primary"></i>
                                @(booking.Adults + booking.Children)
                            </p>
                        </div>
                    </div>

                    <!-- Actions (RIGHT) -->
                    <div class="flex items-center gap-2 shrink-0">
                        @if (booking.Status == "Pending")
                        {
                            <button
                                class="bg-primary hover:bg-primary/90 text-white px-3 py-1.5 rounded-lg text-sm flex items-center gap-1"
                                @onclick="() => UpdateStatus(booking.Id, BookingStatus.Confirmed)">
                                <i class="fa-solid fa-check"></i>
                                Confirm
                            </button>

                            <button
                                class="border border-red-200 text-red-600 hover:bg-red-600 px-3 py-1.5 rounded-lg text-sm flex items-center"
                                @onclick="() => UpdateStatus(booking.Id, BookingStatus.Cancelled)">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        }

                        @if (booking.Status == "Confirmed")
                        {
                            <button
                                class="border border-gray-200 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-50"
                                @onclick="() => UpdateStatus(booking.Id, BookingStatus.Completed)">
                                Mark Complete
                            </button>
                        }

                        <button
                            class="h-8 w-8 rounded-lg flex items-center justify-center"
                            @onclick="() => ShowBookingDetails(booking)">
                            <i class="fa-solid fa-ellipsis"></i>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>


    @if (FilteredBookings.Count == 0)
    {
        <div class="border border-gray-200 rounded-xl bg-white py-16">
            <div class="text-center">
                <div class="w-16 h-16 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-regular fa-calendar text-3xl text-muted-foreground"></i>
                </div>
                <p class="text-lg font-medium font-body">No bookings found</p>
                <p class="text-muted-foreground font-body mt-1">
                    Try adjusting your search or filters
                </p>
            </div>
        </div>
    }
</div>

@code {
    private string searchTerm = "";
    private string statusFilter = "All";
    private string? statusMessage;
    private bool statusMessageSuccess;

    private enum BookingStatus { Pending, Confirmed, Cancelled, Completed }

    private List<Booking> bookings = new()
{
new() { Id = 1, Guest = "John Kamau", Email = "john@email.com", Phone = "+254 712 345 678", Room = "Studio #5", CheckIn
= "2024-12-18", CheckOut = "2024-12-22", Adults = 2, Children = 0, Status = "Confirmed" },
new() { Id = 2, Guest = "Mary Wanjiku", Email = "mary@email.com", Phone = "+254 723 456 789", Room = "1 Bedroom #12",
CheckIn = "2024-12-20", CheckOut = "2024-12-25", Adults = 2, Children = 1, Status = "Pending" },
new() { Id = 3, Guest = "David Ochieng", Email = "david@email.com", Phone = "+254 734 567 890", Room = "2 Bedroom #8",
CheckIn = "2024-12-21", CheckOut = "2025-01-05", Adults = 3, Children = 2, Status = "Confirmed" },
new() { Id = 4, Guest = "Sarah Muthoni", Email = "sarah@email.com", Phone = "+254 745 678 901", Room = "Studio #3",
CheckIn = "2024-12-23", CheckOut = "2024-12-28", Adults = 1, Children = 0, Status = "Pending" },
new() { Id = 5, Guest = "Peter Njoroge", Email = "peter@email.com", Phone = "+254 756 789 012", Room = "1 Bedroom #7",
CheckIn = "2024-12-15", CheckOut = "2024-12-17", Adults = 2, Children = 0, Status = "Completed" },
new() { Id = 6, Guest = "Grace Akinyi", Email = "grace@email.com", Phone = "+254 767 890 123", Room = "2 Bedroom #2",
CheckIn = "2024-12-10", CheckOut = "2024-12-14", Adults = 4, Children = 1, Status = "Cancelled" }
};

    private List<StatusStat> statusStats => new()
{
new() { Label = "All", Count = bookings.Count },
new() { Label = "Pending", Count = bookings.Count(b => b.Status == "Pending") },
new() { Label = "Confirmed", Count = bookings.Count(b => b.Status == "Confirmed") },
new() { Label = "Completed", Count = bookings.Count(b => b.Status == "Completed") },
new() { Label = "Cancelled", Count = bookings.Count(b => b.Status == "Cancelled") }
};

    private List<Booking> FilteredBookings
    {
        get
        {
            var filtered = bookings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(b =>
                b.Guest.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                b.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                b.Room.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter != "All")
            {
                filtered = filtered.Where(b => b.Status == statusFilter);
            }

            return filtered.ToList();
        }
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Join("", parts.Select(p => p[0])).ToUpper();
    }

    private string GetStatButtonClasses(string label)
    {
        var isActive = statusFilter == label;
        return isActive
        ? "bg-primary/20 border-primary/20 shadow-sm"
        : "bg-white border-gray-200 hover:border-gray-300";
    }

    private string GetStatusBadgeClasses(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-primary text-white border-primary/20",
            "Pending" => "bg-accent text-white border-accent/20",
            "Cancelled" => "bg-button text-muted-foreground border-button/20",
            "Completed" => "bg-gray-100 text-muted-foreground border-gray-200",
            _ => "bg-gray-100 text-muted-foreground border-gray-200"
        };
    }

    private void FilterByStatus(string status)
    {
        statusFilter = status;
        StateHasChanged();
    }

    private void UpdateStatus(int id, BookingStatus newStatus)
    {
        var booking = bookings.FirstOrDefault(b => b.Id == id);
        if (booking != null)
        {
            booking.Status = newStatus.ToString();
            statusMessage = $"Booking {newStatus.ToString().ToLower()}!";
            statusMessageSuccess = true;
            StateHasChanged();

            Task.Delay(3000).ContinueWith(_ =>
            {
                statusMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private void ShowNewBookingMessage()
    {
        statusMessage = "New booking form will be available with database integration";
        statusMessageSuccess = false;
        StateHasChanged();

        Task.Delay(3000).ContinueWith(_ =>
        {
            statusMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private void ShowBookingDetails(Booking booking)
    {
        statusMessage = $"More options for {booking.Guest}'s booking";
        statusMessageSuccess = false;
        StateHasChanged();

        Task.Delay(3000).ContinueWith(_ =>
        {
            statusMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private class StatusStat
    {
        public string Label { get; set; } = "";
        public int Count { get; set; }
    }

    private class Booking
    {
        public int Id { get; set; }
        public string Guest { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Room { get; set; } = "";
        public string CheckIn { get; set; } = "";
        public string CheckOut { get; set; } = "";
        public int Adults { get; set; }
        public int Children { get; set; }
        public string Status { get; set; } = "";
    }
}