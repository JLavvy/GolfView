@inherits LayoutComponentBase
@layout MinimalLayout

@inject NavigationManager Navigation

<div class="flex h-screen overflow-hidden bg-card">

    <!-- Mobile Menu Overlay -->
    <div class="@(menuOpen ? "fixed inset-0 bg-black/50 z-40 lg:hidden" : "hidden")" @onclick="ToggleMenu"></div>

    <!-- SIDEBAR NAVIGATION -->
    <aside
        class="@SidebarClass() w-80 bg-white border-r border-border/50 flex flex-col fixed lg:static top-0 bottom-0 left-0 z-50 transition-transform duration-300 overflow-hidden">

        <!-- Mobile Close Button -->
        <button @onclick="ToggleMenu" class="lg:hidden absolute top-4 right-4 p-2 text-gray-500 hover:text-gray-700">
            <i class="fa-solid fa-times text-xl"></i>
        </button>

        <div class="flex-1 overflow-y-auto">
            <div class="space-y-6">

                <div class="px-6 pt-4">
                    <a href="/admin/dashboard" class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                            <span class="text-primary font-bold">GV</span>
                        </div>
                        <div>
                            <p class="text-lg font-semibold font-heading leading-none">GolfView</p>
                            <p class="text-xs text-muted-foreground font-body mt-1">Management Portal</p>
                        </div>
                    </a>
                </div>

                <div class="border-b border border-gray-200"></div>

                <nav class="px-3 py-4 space-y-1">
                    @foreach (var item in navItems)
                    {
                        var active = Navigation.Uri.EndsWith(item.Path);

                        <a href="@item.Path" @onclick="CloseMenuOnMobile"
                            class="@NavItemClass(active) flex items-center gap-3 px-4 py-3 rounded-lg transition-colors duration-200">
                            <i class="@item.Icon w-5 text-center text-black"></i>
                            <span class="font-medium font-body">@item.Label</span>
                        </a>
                    }
                </nav>
            </div>
        </div>

        <div class="p-4 space-y-4 border-t border border-gray-200">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-card border-muted-foreground">
                <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center shrink-0">
                    <span class="text-primary text-sm font-semibold">A</span>
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-medium font-heading truncate">Admin User</p>
                    <p class="text-sm font-body text-muted-foreground truncate">admin@golfview.com</p>
                </div>
            </div>

            <button
                class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:bg-red-50 hover:text-red-600 transition-all duration-200">
                <i class="fa-solid fa-right-from-bracket w-5 text-center"></i>
                <span>Sign out</span>
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 flex flex-col min-h-screen overflow-hidden">


        <section class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-card">
            <div class="max-w-5xl mx-auto w-full">
                @Body
            </div>
        </section>
    </main>

</div>

@code {
    private bool menuOpen = false;

    private List<NavItem> navItems = new()
{
new("/admin/dashboard", "fa-solid fa-chart-line", "Overview"),
new("/admin/dashboard/photos", "fa-solid fa-image", "Photos"),
new("/admin/dashboard/pricing", "fa-solid fa-dollar-sign", "Pricing"),
new("/admin/dashboard/availability", "fa-solid fa-calendar", "Availability"),
new("/admin/dashboard/bookings", "fa-solid fa-clipboard", "Bookings"),
new("/admin/dashboard/contact", "fa-solid fa-phone", "Contact Info")
};

    private string SidebarClass()
    {
        // Mobile: fixed and off-screen by default (-translate-x-full)
        // Desktop: relative (occupies space) and always visible (lg:translate-x-0)
        var baseClass = "fixed lg:relative inset-y-0 left-0";

        return menuOpen
        ? $"{baseClass} translate-x-0"
        : $"{baseClass} -translate-x-full lg:translate-x-0";
    }
    private string NavItemClass(bool active) =>
    "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition " +
    (active
    ? "bg-primary font-body text-white hover:bg-primary/90"
    : "text-black font-body hover:bg-gray-100");

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenuOnMobile()
    {
        menuOpen = false;
    }

    private string GetPageTitle()
    {
        var match = navItems.FirstOrDefault(i => Navigation.Uri.EndsWith(i.Path));
        return match?.Label ?? "Dashboard";
    }

    public record NavItem(string Path, string Icon, string Label);
}