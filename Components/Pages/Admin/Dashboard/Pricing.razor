@page "/admin/dashboard/pricing"
@layout Pages.Admin.Dashboard.Layout

<div class="space-y-6 animate-fade-in">

    <!-- Header -->
    <div class="flex flex-wrap items-center gap-4">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold font-heading">Pricing</h2>
            <p class="text-muted-foreground font-body mt-1">
                Manage room rates and amenity pricing
            </p>
        </div>

        <div class="flex items-center gap-3 ml-auto">
            <button
                class="bg-primary hover:bg-primary/20 text-white px-4 py-2 rounded-lg shadow-lg flex items-center gap-2"
                @onclick="SaveChanges"
                disabled="@isSaving">

                @if (isSaving)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fa-solid fa-floppy-disk"></i>
                }

                @(isSaving ? "Saving..." : "Save Changes")
            </button>
        </div>
    </div>

    @if (saveMessage != null)
    {
        <div class="bg-primary border border-gray-200 text-white rounded-lg p-4">
            <p class="text-sm font-medium font-body">@saveMessage</p>
        </div>
    }

    <!-- Quick Stats -->
    <div class="grid sm:grid-cols-1 lg:grid-cols-3 gap-4 bg-white">
        <div class="border border-gray-200 rounded-xl p-5">
            <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-primary/10">
                    <i class="fa-solid fa-dollar-sign text-primary"></i>
                </div>
                <div>
                    <p class="text-sm text-muted-foreground font-body">Avg. Daily Rate</p>
                    <p class="text-2xl font-heading">
                        Ksh @CalculateAverageDailyRate().ToString("N0")
                    </p>
                </div>
            </div>
        </div>

        <div class="border border-gray-200 rounded-xl p-5">
            <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-accent/10">
                    <i class="fa-solid fa-arrow-trend-up text-accent"></i>
                </div>
                <div>
                    <p class="text-sm text-muted-foreground font-body">Revenue Potential</p>
                    <p class="text-2xl font-heading">Ksh 325K</p>
                </div>
            </div>
        </div>

        <div class="border border-gray-200 rounded-xl bg-gradient-to-br from-blue-50 to-transparent p-5">
            <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-primary/10">
                    <i class="fa-solid fa-clock text-primary"></i>
                </div>
                <div>
                    <p class="text-sm text-muted-foreground font-body">Last Updated</p>
                    <p class="text-2xl font-heading">@lastUpdated</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Room Rates -->
    <div class="space-y-4">
        <div class="flex items-center gap-2">
            <h3 class="text-lg font-semibold font-body">Room Rates</h3>
            <span class="px-2 py-1 text-sm border border-gray-200 rounded font-bold font-body">KES</span>
        </div>

        @foreach (var rate in rates)
        {
            <div class="border border-gray-200 rounded-xl bg-white hover:border-gray-300 transition-colors">

                <div class="p-6 border-b border-gray-200">
                    <div class="flex items-center gap-3">
                        <i class="@rate.IconClass text-lg text-primary"></i>
                        <h4 class="text-lg font-semibold">@rate.Name</h4>
                    </div>
                </div>

                <div class="p-6 grid sm:grid-cols-2 md:grid-cols-4 gap-4">

                    <div class="space-y-2">
                        <label class="text-sm uppercase tracking-wider text-muted-foreground font-body flex items-center gap-2">
                            <i class="fa-solid fa-bed text-primary"></i>
                            Daily (Bed Only)
                        </label>
                        <div class="relative">

                            <input type="number" @bind="rate.DailyBedOnly" @bind:event="oninput"
                                   class="w-full pl-12 px-4 py-2 bg-card border border-gray-200 rounded-lg font-medium" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm uppercase tracking-wider text-muted-foreground font-body flex items-center gap-2">
                            <i class="fa-solid fa-mug-hot text-primary"></i>
                            Daily (B&B)
                        </label>
                        <div class="relative">

                            <input type="number" @bind="rate.DailyBnB" @bind:event="oninput"
                                   class="w-full pl-12 px-4 py-2 bg-card border border-gray-200 rounded-lg font-medium" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm uppercase tracking-wider text-muted-foreground font-body flex items-center gap-2">
                            <i class="fa-solid fa-calendar text-primary"></i>
                            Monthly (Bed Only)
                        </label>
                        <div class="relative">
                            
                            <input type="number" @bind="rate.MonthlyBedOnly" @bind:event="oninput"
                                   class="w-full pl-12 px-4 py-2 bg-card border border-gray-200 rounded-lg font-medium" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm uppercase tracking-wider text-muted-foreground font-body flex items-center gap-2">
                            <i class="fa-solid fa-calendar-check text-primary"></i>
                            Monthly (B&B)
                        </label>
                        <div class="relative">
                            
                            <input type="number" @bind="rate.MonthlyBnB" @bind:event="oninput"
                                   class="w-full pl-12 px-4 py-2 bg-card border border-gray-200 rounded-lg font-medium" />
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

    <!-- Amenity Pricing -->
    <div class="border border-gray-200 rounded-xl bg-white">
        <div class="p-6 border-b border-gray-200">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold font-heading">Amenity Access</h3>
                <span class="px-4 py-2 text-sm border border-gray-200 bg-accent text-white rounded">
                    Non-Resident Rates
                </span>
            </div>
            <p class="text-sm text-muted-foreground font-body mt-1">
                Daily rates for non-resident access to facilities
            </p>
        </div>

        <div class="p-6 grid sm:grid-cols-2 md:grid-cols-4 gap-4">
            @foreach (var amenity in amenities)
            {
                <div class="p-4 rounded-xl bg-card border border-gray-200">
                    <div class="flex items-center gap-2 mb-3">
                        <i class="@amenity.IconClass text-xl text-primary"></i>
                        <span class="font-medium text-sm">@amenity.Name</span>
                    </div>

                    <div class="relative">
                       
                        <input type="number" @bind="amenity.Price" @bind:event="oninput"
                               class="w-full pl-12 pr-3 py-2 bg-white border border-gray-200 rounded-lg font-medium" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isSaving;
    private string? saveMessage;
    private string lastUpdated = "Just now";

    private List<RoomRate> rates = new()
    {
        new()
        {
            Name = "Studio Apartment",
            DailyBedOnly = 5500,
            DailyBnB = 6500,
            MonthlyBedOnly = 75000,
            MonthlyBnB = 90000,
            IconClass = "fa-solid fa-house-chimney"
        },
        new()
        {
            Name = "1 Bedroom Apartment",
            DailyBedOnly = 7500,
            DailyBnB = 8500,
            MonthlyBedOnly = 100000,
            MonthlyBnB = 120000,
            IconClass = "fa-solid fa-house-chimney"
        },
        new()
        {
            Name = "2 Bedroom Apartment",
            DailyBedOnly = 12000,
            DailyBnB = 14000,
            MonthlyBedOnly = 150000,
            MonthlyBnB = 180000,
            IconClass = "fa-solid fa-house-chimney"
        }
    };

    private List<Amenity> amenities = new()
    {
        new() { Name = "Gym Access", IconClass = "fa-solid fa-dumbbell", Price = 500 },
        new() { Name = "Pool Access", IconClass = "fa-solid fa-person-swimming", Price = 500 },
        new() { Name = "Steam Bath", IconClass = "fa-solid fa-hot-tub-person", Price = 1000 },
        new() { Name = "Sauna", IconClass = "fa-solid fa-fire", Price = 1000 }
    };

    private decimal CalculateAverageDailyRate()
    {
        var totalBedOnly = rates.Sum(r => r.DailyBedOnly);
        var totalBnB = rates.Sum(r => r.DailyBnB);
        return (totalBedOnly + totalBnB) / (rates.Count * 2);
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        saveMessage = null;
        StateHasChanged();

        await Task.Delay(1000);

        isSaving = false;
        saveMessage = "Pricing updated successfully!";
        lastUpdated = "Just now";
        StateHasChanged();

        await Task.Delay(3000);
        saveMessage = null;
        StateHasChanged();
    }

    private class RoomRate
    {
        public string Name { get; set; } = "";
        public decimal DailyBedOnly { get; set; }
        public decimal DailyBnB { get; set; }
        public decimal MonthlyBedOnly { get; set; }
        public decimal MonthlyBnB { get; set; }
        public string IconClass { get; set; } = "";
    }

    private class Amenity
    {
        public string Name { get; set; } = "";
        public string IconClass { get; set; } = "";
        public decimal Price { get; set; }
    }
}
