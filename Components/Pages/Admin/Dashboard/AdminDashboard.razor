@page "/admin/dashboard"
@page "/admin/dashboard/{*PageRoute}"
@layout MinimalLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="min-h-screen bg-[#f5f5f0] flex">
    <!-- Mobile Menu Button -->
    <button class="lg:hidden fixed top-4 left-4 z-50 p-2 bg-white rounded-lg shadow-md"
            @onclick="ToggleSidebar">
        @if (sidebarOpen)
        {
            <i class="fas fa-times w-6 h-6"></i>
        }
        else
        {
            <i class="fas fa-bars w-6 h-6"></i>
        }
    </button>

    <!-- Sidebar -->
    <aside class="@GetSidebarClass()">
        <div class="flex flex-col h-full">
            <div class="p-6 border-b border-gray-200">
                <a href="/" class="block">
                    <span class="text-2xl font-serif text-[#4a7c3c]">GolfView</span>
                    <span class="text-sm text-[#c9a961] ml-2">Admin</span>
                </a>
            </div>

            <nav class="flex-1 py-4 overflow-y-auto">
                @foreach (var item in navItems)
                {
                    <a href="@item.Path"
                       class="@GetNavItemClass(item.Path)"
                       @onclick="() => HandleNavClick(item.Path)"
                       @onclick:preventDefault="false">
                        <i class="@item.Icon w-4 h-4"></i>
                        <span>@item.Label</span>
                    </a>
                }
            </nav>

            <div class="p-4 border-t border-gray-200">
                <button class="w-full flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-md transition-colors"
                        @onclick="HandleLogout">
                    <i class="fas fa-sign-out-alt w-4 h-4"></i>
                    <span>Logout</span>
                </button>
            </div>
        </div>
    </aside>

    <!-- Overlay -->
    @if (sidebarOpen)
    {
        <div class="fixed inset-0 bg-black/50 z-30 lg:hidden"
             @onclick="CloseSidebar">
        </div>
    }

    <!-- Main Content -->
    <main class="flex-1 p-8 pt-8 lg:ml-64 overflow-y-auto h-screen">
        @switch (currentRoute)
        {
            case "":
            case "/":
                <Overview />
                break;
            case "/photos":
                <Photos />
                break;
            case "/pricing":
                <Pricing />
                break;
            case "/availability":
                <Availability />
                break;
            case "/bookings":
                <Bookings />
                break;
            case "/contact":
                <ContactInfo />
                break;
            default:
                <Overview />
                break;
        }
    </main>
</div>

@code {
    [Parameter]
    public string? PageRoute { get; set; }

    private bool sidebarOpen = false;
    private string currentRoute = "";

    private List<NavItem> navItems = new List<NavItem>
    {
        new NavItem { Path = "/admin/dashboard", Icon = "fas fa-th-large", Label = "Overview" },
        new NavItem { Path = "/admin/dashboard/photos", Icon = "far fa-image", Label = "Photos" },
        new NavItem { Path = "/admin/dashboard/pricing", Icon = "fas fa-dollar-sign", Label = "Pricing" },
        new NavItem { Path = "/admin/dashboard/availability", Icon = "far fa-calendar-alt", Label = "Availability" },
        new NavItem { Path = "/admin/dashboard/bookings", Icon = "far fa-clipboard", Label = "Bookings" },
        new NavItem { Path = "/admin/dashboard/contact", Icon = "fas fa-phone", Label = "Contact Info" },
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        UpdateCurrentRoute();
    }

    protected override void OnParametersSet()
    {
        UpdateCurrentRoute();
    }

    private void UpdateCurrentRoute()
    {
        currentRoute = PageRoute ?? "";
        if (currentRoute.StartsWith("/"))
        {
            // Already has leading slash
        }
        else if (!string.IsNullOrEmpty(currentRoute))
        {
            currentRoute = "/" + currentRoute;
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateCurrentRoute();
        StateHasChanged();
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private void HandleNavClick(string path)
    {
        sidebarOpen = false;
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/admin");
    }

    private string GetSidebarClass()
    {
        return $"fixed inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 transition-transform duration-300 lg:translate-x-0 {(sidebarOpen ? "translate-x-0" : "-translate-x-full")}";
    }

    private string GetNavItemClass(string path)
    {
        var isActive = Navigation.Uri.EndsWith(path) || 
                       (path == "/admin/dashboard" && Navigation.Uri.EndsWith("/admin/dashboard"));
        
        return $"flex items-center gap-3 px-6 py-3 text-sm transition-colors {(isActive ? "bg-[#4a7c3c] text-white border-l-4 border-[#4a7c3c]" : "text-gray-600 hover:bg-gray-50")}";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private class NavItem
    {
        public string Path { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Label { get; set; } = "";
    }
}