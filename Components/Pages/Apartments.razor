@page "/apartments"
@using GolfViewApartments.Data
@using GolfViewApartments.Models
@namespace GolfViewApartments.Components.UI

<!-- Hero Section -->
<section class="bg-primary py-20">
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
        <div class="max-w-2xl">
            <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-4">
                Our Apartments
            </h1>
            <p class="text-white font-body text-lg">
                Choose from @ApartmentData.TotalUnits beautifully appointed apartments across studios,
                1-bedroom, and 2-bedroom configurations. All rooms feature 5x6 beds.
            </p>
        </div>
    </div>
</section>

<!-- Quick Info Cards -->
<section class="py-12 ">
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Room Specs -->
            <div class="bg-card rounded-xl p-6 shadow-soft">
                <div class="flex items-center gap-3 mb-4">
                    <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                        <i class="fas fa-bed text-primary"></i>
                    </div>
                    <h3 class="font-heading font-semibold text-black">Room Specs</h3>
                </div>
                <ul class="space-y-2 text-sm">
                    @foreach (var apt in ApartmentData.Apartments)
                    {
                        <li class="flex items-center justify-between">
                            <span class="text-black font-body">@apt.Name</span>
                            <span class="text-muted-foreground font-body">@apt.Size • Max @apt.MaxGuests</span>
                        </li>
                    }
                    <li class="pt-2 border-t border-border font-body text-muted-foreground">
                        All beds: 5x6 size
                    </li>
                </ul>
            </div>

            <!-- Meal Plans -->
            <div class="bg-card rounded-xl p-6 shadow-soft">
                <div class="flex items-center gap-3 mb-4">
                    <div class="h-10 w-10 rounded-full bg-accent/20 flex items-center justify-center">
                        <i class="fas fa-utensils text-accent"></i>
                    </div>
                    <h3 class="font-heading font-semibold text-black">Meal Plans</h3>
                </div>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    @foreach (var plan in ApartmentData.MealPlans)
                    {
                        <li class="flex items-center justify-between font-body">
                            <span class="font-medium text-black">@plan.Value.Label</span>
                            <span>@plan.Value.ShortLabel</span>
                        </li>
                    }
                </ul>
            </div>

            <!-- Total Units -->
            <div class="bg-card rounded-xl p-6 shadow-soft">
                <div class="flex items-center gap-3 mb-4">
                    <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                        <i class="fas fa-users text-primary"></i>
                    </div>
                    <h3 class="font-heading font-semibold text-black">Availability</h3>
                </div>
                <div class="space-y-2 text-sm font-body">
                    @foreach (var apt in ApartmentData.Apartments)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-black">@apt.Name</span>
                            <span class="text-muted-foreground">@apt.Units units</span>
                        </div>
                    }
                    <div
                        class="border-t border-border pt-2 font-body mt-2 flex items-center justify-between font-semibold">
                        <span class="text-black">Total</span>
                        <span class="text-primary">@ApartmentData.TotalUnits apartments</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Rates Table -->
<section class="py-16">
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-black mb-8 text-center">
            Room Rates
        </h2>
        <RatesTable />
    </div>
</section>

<!-- Availability & Building Layout -->
<section class="py-16 bg-card">
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px_px-[88px] max-w-[1440px]">
        <div class="grid lg:grid-cols-2 gap-12">
            <div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-black mb-6">
                    Check Availability
                </h2>
                <AvailabilityCalender />
            </div>
            <div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-black mb-6">
                    Building Layout
                </h2>
                <BuildingLayout />
            </div>
        </div>
    </div>
</section>

<!-- Apartments List -->
<section class="py-16">
    <div class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px]">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-black mb-8 text-center">
            Apartment Details
        </h2>
        <div class="space-y-12 ">
            @for (int index = 0; index < ApartmentData.Apartments.Count; index++)
            {
                var apartment = ApartmentData.Apartments[index];
                var isReversed = index % 2 == 1;

                <div class="grid lg:grid-cols-2 gap-8 items-center">
                    <div class="@(isReversed ? "lg:order-2" : "")">
                        <a href="/apartments/@apartment.Id" class="block group">
                            <div class="relative overflow-hidden rounded-xl font-body">
                                <img src="@apartment.Image" alt="@apartment.Name"
                                    class="w-full h-[400px] object-cover transition-transform duration-500 group-hover:scale-105" />
                                <div
                                    class="absolute top-4 left-4 bg-primary text-black font-body px-3 py-1.5 rounded-full text-xs font-medium">
                                    @apartment.Units Units Available
                                </div>
                                <div class="absolute top-4 right-4 space-y-2">
                                    <div
                                        class="bg-accent text-black font-body px-4 py-2 rounded-full font-semibold text-sm">
                                        KES @apartment.Pricing.DailyBedOnly.ToString("N0")/night
                                    </div>
                                    <div class="bg-white text-accent px-4 py-2 rounded-full font-semibold text-sm">
                                        KES @apartment.Pricing.MonthlyBedOnly.ToString("N0")/month
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="space-y-6 @(isReversed ? "lg:order-1" : "")">
                        <div>
                            <span class="text-xs font-medium text-primary font-body uppercase tracking-wide">
                                @apartment.Type.Replace("-", " ") • @apartment.Bedrooms
                            </span>
                            <h2 class="text-3xl font-heading font-bold text-black mt-1 mb-3">
                                @apartment.Name
                            </h2>
                            <p class="text-muted-foreground font-body leading-relaxed">
                                @apartment.Description
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-6 text-sm">
                            <div class="flex items-center gap-2 text-muted-foreground">
                                <i class="fas fa-users h-5 w-5 text-primary"></i>
                                <span class="font-body">Max @apartment.MaxGuests Guests</span>
                            </div>
                            <div class="flex items-center gap-2 text-muted-foreground">
                                <i class="fas fa-ruler-combined h-5 w-5 text-primary"></i>
                                <span class="font-body">@apartment.Size</span>
                            </div>
                            <div class="flex items-center gap-2 text-muted-foreground">
                                <i class="fas fa-bed h-5 w-5 text-primary"></i>
                                <span class="font-body">@apartment.BedSize Bed</span>
                            </div>
                            <div class="flex items-center gap-2 text-muted-foreground">
                                <i class="fas fa-bath h-5 w-5 text-primary"></i>
                                <span class="font-body">@apartment.Bathrooms Bath</span>
                            </div>
                        </div>

                        <div>
                            <h4 class="text-sm font-semibold font-heading text-black mb-3">
                                Amenities
                            </h4>

                            <div class="flex flex-wrap gap-2 font-body p-4 rounded-lg">
                                @foreach (var amenity in apartment.Amenities.Take(6))
                                {
                                    <span
                                        class="inline-flex items-center gap-1.5 bg-primary/10 text-black px-3 py-1.5 rounded-full text-sm">

                                        @if (amenity.Contains("WiFi"))
                                        {
                                            <i class="fas fa-wifi"></i>
                                        }
                                        else if (amenity.Contains("Air Conditioning"))
                                        {
                                            <i class="fas fa-snowflake"></i>
                                        }
                                        else if (amenity.Contains("TV"))
                                        {
                                            <i class="fas fa-tv"></i>
                                        }
                                        else if (amenity.Contains("Kitchen"))
                                        {
                                            <i class="fas fa-utensils"></i>
                                        }
                                        else if (amenity.Contains("Parking"))
                                        {
                                            <i class="fas fa-parking"></i>
                                        }
                                        else if (amenity.Contains("Pool"))
                                        {
                                            <i class="fas fa-swimming-pool"></i>
                                        }
                                        else if (amenity.Contains("Gym"))
                                        {
                                            <i class="fas fa-dumbbell"></i>
                                        }
                                        else if (amenity.Contains("Laundry"))
                                        {
                                            <i class="fas fa-shirt"></i>
                                        }
                                        else if (amenity.Contains("Security"))
                                        {
                                            <i class="fas fa-shield-halved"></i>
                                        }
                                        else if (amenity.Contains("Balcony"))
                                        {
                                            <i class="fas fa-house-flag"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check"></i>
                                        }

                                        @amenity
                                    </span>
                                }

                                @if (apartment.Amenities.Count > 6)
                                {
                                    <span
                                        class="inline-flex items-center bg-primary/10 text-muted-foreground px-3 py-1.5 rounded-full text-sm">
                                        + more amenities
                                    </span>
                                }
                            </div>


                        </div>

                        <!-- Pricing Summary -->
                        <div class="rounded-lg p-4">
                            <h4 class="text-sm font-semibold font-heading text-black mb-3">Rates (KES):</h4>
                            <div class="grid grid-cols-2 gap-4 text-sm">
                                <div>
                                    <span class="text-muted-foreground font-body">Daily B/O</span>
                                    <p class="font-semibold text-black">@apartment.Pricing.DailyBedOnly.ToString("N0")
                                    </p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground font-body">Daily B+B</span>
                                    <p class="font-semibold text-black">@apartment.Pricing.DailyBB.ToString("N0")</p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground font-body">Monthly B/O</span>
                                    <p class="font-semibold text-black">
                                        @apartment.Pricing.MonthlyBedOnly.ToString("N0")</p>
                                </div>
                                <div>
                                    <span class="text-muted-foreground font-body">Monthly B+B</span>
                                    <p class="font-semibold text-black">@apartment.Pricing.MonthlyBB.ToString("N0")</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-4">
                            <a href="/booking"
                                class="inline-flex items-center justify-center bg-accent hover:bg-accent/90 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
                                Book Now
                            </a>
                            <a href="/apartments/@apartment.Id"
                                class="inline-flex items-center justify-center border border-border hover:bg-secondary text-black font-semibold px-6 py-3 rounded-lg transition-colors">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-16 bg-primary/10">
    <div
        class="relative w-full container mx-auto px-4 sm:px-2 md:px-14 lg:px-18 xl:px-[88px] max-w-[1440px] text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-black mb-4">
            Need Help Choosing?
        </h2>
        <p class="text-muted-foreground max-w-xl mx-auto mb-6">
            Our team is here to help you find the perfect apartment for your stay.
            Contact us for personalized recommendations.
        </p>
        <a href="/contact"
            class="inline-flex items-center justify-center bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-6 py-3 rounded-lg transition-colors">
            Contact Us
        </a>
    </div>
</section>